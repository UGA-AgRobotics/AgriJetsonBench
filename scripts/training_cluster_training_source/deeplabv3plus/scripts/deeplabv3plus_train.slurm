#!/bin/bash
#SBATCH --job-name=deeplabv3plus_cropweed
#SBATCH --partition=gpu_p
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:L4:4
#SBATCH --cpus-per-task=32
#SBATCH --mem=96G
#SBATCH --time=168:00:00
#SBATCH --output=%x_%j.out
#SBATCH --error=%x_%j.err

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PACKAGE_DIR="${PACKAGE_DIR:-$(cd "$SCRIPT_DIR/.." && pwd)}"
CONFIG="${CONFIG:-$PACKAGE_DIR/config/segmentation_deeplabv3plus_train_lock.yaml}"
PIPELINE_MODE="${PIPELINE_MODE:-full}"
VENV_PATH="${VENV_PATH:-/home/$USER/envs/segment}"
DEEPLABV3PLUS_REQUESTED_GPUS="${DEEPLABV3PLUS_REQUESTED_GPUS:-4}"
DEEPLABV3PLUS_NODE_COUNT="${DEEPLABV3PLUS_NODE_COUNT:-${SLURM_JOB_NUM_NODES:-1}}"
DEEPLABV3PLUS_DDP_LAUNCHER="${DEEPLABV3PLUS_DDP_LAUNCHER:-torchrun}"

if [[ "$DEEPLABV3PLUS_REQUESTED_GPUS" =~ ^[0-9]+$ ]] && (( DEEPLABV3PLUS_REQUESTED_GPUS > 1 )); then
  export OMP_NUM_THREADS=$(( ${SLURM_CPUS_PER_TASK:-1} / DEEPLABV3PLUS_REQUESTED_GPUS ))
  if (( OMP_NUM_THREADS < 1 )); then
    export OMP_NUM_THREADS=1
  fi
else
  export OMP_NUM_THREADS="${SLURM_CPUS_PER_TASK:-1}"
fi

echo "[INFO] Hostname     : $(hostname)"
echo "[INFO] Job ID       : ${SLURM_JOB_ID:-none}"
echo "[INFO] Package      : $PACKAGE_DIR"
echo "[INFO] Config       : $CONFIG"
echo "[INFO] Mode         : $PIPELINE_MODE"
echo "[INFO] Venv         : $VENV_PATH"
echo "[INFO] Nodes        : $DEEPLABV3PLUS_NODE_COUNT"
echo "[INFO] GPUs/node    : $DEEPLABV3PLUS_REQUESTED_GPUS"
echo "[INFO] Total GPUs   : $(( DEEPLABV3PLUS_NODE_COUNT * DEEPLABV3PLUS_REQUESTED_GPUS ))"
echo "[INFO] OMP threads  : $OMP_NUM_THREADS"

cd "$PACKAGE_DIR"
source "$PACKAGE_DIR/scripts/activate_stage2_env.sh" "$VENV_PATH"
export DEEPLABV3PLUS_REQUESTED_GPUS
export DEEPLABV3PLUS_NODE_COUNT
export DEEPLABV3PLUS_DDP_LAUNCHER
export DEEPLABV3PLUS_OPT_FOREACH="${DEEPLABV3PLUS_OPT_FOREACH:-0}"
if [[ "${DEEPLABV3PLUS_NODE_COUNT:-1}" =~ ^[0-9]+$ ]] && (( DEEPLABV3PLUS_NODE_COUNT <= 1 )) && [[ "${DEEPLABV3PLUS_REQUESTED_GPUS:-1}" =~ ^[0-9]+$ ]] && (( DEEPLABV3PLUS_REQUESTED_GPUS > 1 )); then
  export DEEPLABV3PLUS_SINGLE_NODE_MULTI_GPU="${DEEPLABV3PLUS_SINGLE_NODE_MULTI_GPU:-ddp}"
  export DEEPLABV3PLUS_DIST_BACKEND="${DEEPLABV3PLUS_DIST_BACKEND:-gloo}"
  export DEEPLABV3PLUS_DISABLE_LR_MUL="${DEEPLABV3PLUS_DISABLE_LR_MUL:-1}"
fi
export PYTHONFAULTHANDLER="${PYTHONFAULTHANDLER:-1}"
export TORCH_DISTRIBUTED_DEBUG="${TORCH_DISTRIBUTED_DEBUG:-INFO}"
export TORCH_SHOW_CPP_STACKTRACES="${TORCH_SHOW_CPP_STACKTRACES:-1}"
export TORCH_NCCL_BLOCKING_WAIT="${TORCH_NCCL_BLOCKING_WAIT:-1}"
export NCCL_ASYNC_ERROR_HANDLING="${NCCL_ASYNC_ERROR_HANDLING:-1}"
export NCCL_DEBUG="${NCCL_DEBUG:-INFO}"
export NCCL_DEBUG_SUBSYS="${NCCL_DEBUG_SUBSYS:-INIT}"
if [[ "${DEEPLABV3PLUS_NODE_COUNT:-1}" =~ ^[0-9]+$ ]] && (( DEEPLABV3PLUS_NODE_COUNT <= 1 )); then
  export NCCL_IB_DISABLE="${NCCL_IB_DISABLE:-1}"
  export NCCL_P2P_DISABLE="${NCCL_P2P_DISABLE:-1}"
  export NCCL_SHM_DISABLE="${NCCL_SHM_DISABLE:-1}"
  unset NCCL_SOCKET_IFNAME
else
  export NCCL_IB_DISABLE="${NCCL_IB_DISABLE:-0}"
  export NCCL_P2P_DISABLE="${NCCL_P2P_DISABLE:-0}"
  export NCCL_SHM_DISABLE="${NCCL_SHM_DISABLE:-0}"
  export NCCL_SOCKET_IFNAME="${NCCL_SOCKET_IFNAME:-ib0}"
fi
export DEEPLABV3PLUS_DIST_TIMEOUT_SEC="${DEEPLABV3PLUS_DIST_TIMEOUT_SEC:-600}"
export MASTER_ADDR="${MASTER_ADDR:-$(scontrol show hostnames "$SLURM_JOB_NODELIST" | head -n1)}"
export MASTER_PORT="${MASTER_PORT:-$(( 15000 + (${SLURM_JOB_ID:-0} % 20000) ))}"
echo "[INFO] MASTER_ADDR  : $MASTER_ADDR"
echo "[INFO] MASTER_PORT  : $MASTER_PORT"

python "$PACKAGE_DIR/scripts/stage2_deeplabv3plus_pipeline.py" --config "$CONFIG" --mode "$PIPELINE_MODE"
